# Required: API key for the OpenAI API (or any OpenAI-compatible provider).
OPENAI_API_KEY=

# Optional: point to an OpenAI-compatible endpoint (Groq, Ollama, OpenRouter...).
# Leave empty to use api.openai.com.
OPENAI_BASE_URL=

# Optional: model name. The model must support tool (function) calling.
MODEL=gpt-5.4-mini
